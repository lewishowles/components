{
	"name": "@lewishowles/components",
	"version": "3.1.0",
	"description": "A library of beautiful components, promoting rapid development, while ensuring that usability and accessibility are at the fore.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lewishowles/components.git"
	},
	"bin": {
		"components": "./bin/cli.js"
	},
	"files": [
		"bin",
		"CHANGELOG.md",
		"dist",
		"src/cli",
		"src/components/component-metadata.js",
		"src/components/**/*.metadata.js",
		"src/components/**/examples/**"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"main": "dist/components.js",
	"module": "dist/components.js",
	"imports": {
		"#test/*": "./test/*"
	},
	"exports": {
		".": {
			"import": "./dist/components.js"
		},
		"./composables": {
			"types": "./dist/composables.d.ts",
			"import": "./dist/composables.js"
		},
		"./utilities": {
			"types": "./dist/utilities.d.ts",
			"import": "./dist/utilities.js"
		},
		"./resolver": {
			"types": "./dist/resolver.d.ts",
			"import": "./dist/resolver.js"
		},
		"./source": "./dist/source.css",
		"./styles": "./dist/styles.css",
		"./styles/animation": "./dist/css/animation.css",
		"./styles/buttons": "./dist/css/buttons.css",
		"./styles/components": "./dist/css/components.css",
		"./styles/form": "./dist/css/form.css",
		"./styles/main": "./dist/css/main.css",
		"./styles/theme": "./dist/css/theme.css"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "vp dev",
		"test:unit": "vp test",
		"test:component": "playwright test -c test/playwright-ct.config.js --project=chromium",
		"build": "vp build",
		"build:docs": "vp build --config support/vite.config.docs.js",
		"deploy": "bun run build:docs && bun run deploy:docs",
		"deploy:docs": "gh-pages -d dist-docs --cname components.howles.dev --dotfiles",
		"preview": "bun run build:docs && vp preview --config support/vite.config.docs.js",
		"publint": "publint",
		"lint": "vp check",
		"lint:fix": "vp check --fix",
		"check:declarations": "node scripts/check-declarations.js",
		"check:exports": "pkg-checks exports . --config quality.config.json",
		"attw": "attw --pack --profile esm-only --exclude-entrypoints '.' './source' './styles' './styles/animation' './styles/buttons' './styles/components' './styles/form' './styles/main' './styles/theme'",
		"prepare": "vp config --no-agent"
	},
	"dependencies": {
		"@clack/prompts": "^1.7.0",
		"@lewishowles/cli-style": "^0.11.0",
		"@lewishowles/helpers": "^1.7.1",
		"@vueuse/core": "^14.4.0",
		"cli-highlight": "^2.1.11",
		"clsx": "^2.1.1",
		"nanoid": "^6.0.1",
		"tailwind-merge": "^3.6.0",
		"temporal-polyfill": "^1.0.3"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@eslint/js": "^10.0.1",
		"@lewishowles/lint-config": "0.2.0",
		"@lewishowles/pkg-checks": "^0.2.3",
		"@lewishowles/testing": "^1.2.1",
		"@playwright/experimental-ct-vue": "^1.62.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@vitejs/plugin-vue": "^6.0.8",
		"@vue/test-utils": "^2.4.11",
		"axe-core": "^4.13.0",
		"eslint-plugin-vue": "^10.10.0",
		"gh-pages": "^6.3.0",
		"globals": "^17.9.0",
		"happy-dom": "^20.11.1",
		"publint": "^0.3.23",
		"shiki": "^4.4.2",
		"tailwindcss": "^4.3.3",
		"tailwindcss-hocus": "^1.0.0",
		"typescript": "6.0.2",
		"unplugin-vue-components": "^32.1.0",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.2.8",
		"vite-plugin-vue-devtools": "^8.2.1",
		"vite-plus": "0.2.8",
		"vue-component-meta": "^3.3.9",
		"vue-eslint-parser": "^10.4.1",
		"vue-router": "^5.2.0"
	},
	"peerDependencies": {
		"vue": "^3.4.0"
	},
	"overrides": {
		"temporal-polyfill": "^1.0.3"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "bun@1.3.14"
}
